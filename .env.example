# Compose local settings
POSTGRES_PASSWORD=careerlens
CAREERLENS_JWT_SECRET=local-development-secret-replace-before-production
CAREERLENS_ENVIRONMENT=development
CAREERLENS_ADMINS=[]
CAREERLENS_ALLOWED_ORIGINS=["http://localhost:3000"]
CAREERLENS_SEED_COUNT=5000
CAREERLENS_GREENHOUSE_BOARDS=figma,duolingo
CAREERLENS_AGENT_LIVE_SEARCH=true
CAREERLENS_HIMALAYAS_SEARCH_ENABLED=true

# Compose runs a local language model for chat and local extraction for resumes.
CAREERLENS_AGENT_MODEL_PROVIDER=llama
CAREERLENS_LLM_PROVIDER=local
# Use groq for both provider settings to enable Groq for chat and resumes.
CAREERLENS_GROQ_API_KEY=
CAREERLENS_GROQ_MODEL=openai/gpt-oss-20b
CAREERLENS_OPENAI_API_KEY=
CAREERLENS_OPENAI_MODEL=gpt-4.1-mini
# CAREERLENS_LLM_INPUT_USD_PER_MILLION=
# CAREERLENS_LLM_OUTPUT_USD_PER_MILLION=
CAREERLENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# For hosted embeddings with no local model, use gemini-embedding-001 and set a key (384-dim output).
CAREERLENS_GEMINI_API_KEY=
CAREERLENS_CROSS_ENCODER=
# Embedding dependencies are built by default. Add --extra judges for DeepEval.

# Langfuse Cloud
# Set CAREERLENS_TELEMETRY_ENABLED=false to disable Langfuse even when keys are configured.
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# NEXT_PUBLIC_LANGFUSE_URL= can override the Langfuse link in the workspace.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SAMPLE_RATE=1.0
CAREERLENS_ONLINE_EVAL_RATE=0
